# Website (Next.js) environment. Copy to .env.local for local development and set the same
# values in the Vercel project. See docs/supabase-website-connection.md.

NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Server-only. Never expose to browser code.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Must equal RESERVATION_TOKEN_SECRET in supabase/.env (Edge Function secret)
RESERVATION_TOKEN_SECRET=change-me-to-a-long-random-string

# Frontend preview with sample data instead of Supabase. Never set this on the real site.
# PW_PREVIEW=1

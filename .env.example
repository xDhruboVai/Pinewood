# --- Next.js app (Vercel project env vars) ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# Project Settings -> API Keys -> Publishable key (legacy "anon" key also works)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx
# Project Settings -> API Keys -> Secret key (legacy "service_role" key also works). Server-only.
SUPABASE_SECRET_KEY=sb_secret_xxx
# Shared with the reservation-email Edge Function. Generate: openssl rand -base64 48
RESERVATION_TOKEN_SECRET=change-me-to-a-long-random-string

# --- Edge Function secrets (set with `supabase secrets set --env-file supabase/.env`) ---
# See supabase/.env.example

# Edge Function secrets. Copy to supabase/.env and run:
#   supabase secrets set --env-file supabase/.env
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are injected automatically by Supabase.

RESEND_API_KEY=re_xxx
# Must be on a domain you verified in Resend
EMAIL_FROM="Pinewood Cafe + Kitchen <reservations@yourdomain.com>"
EMAIL_REPLY_TO=hello@yourdomain.com
SITE_URL=https://yourdomain.com
# Same value as the Next.js RESERVATION_TOKEN_SECRET
RESERVATION_TOKEN_SECRET=change-me-to-a-long-random-string
# Same value as the Vault secret "pinewood_webhook_secret"
WEBHOOK_SECRET=change-me-too
RESTAURANT_PHONE=+8801914426939
